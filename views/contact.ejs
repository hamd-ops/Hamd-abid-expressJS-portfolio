<!--Includes the shared header and navigation-->
<%- include('partials/header') %>

<!--Main contains the contact page content-->
<main class="container page-content">

<h1>Contact Me</h1>
<p>
If you would like to contact me, fill out the form below
or email me at
<a class="contact-link" href="mailto:hamd.abid@ontariotechu.net">
hamd.abid@ontariotechu.net</a>.
</p>
<!--Form uses the visitor's configured email application-->
<form class="contact-form project-card"
action="mailto:hamd.abid@ontariotech.net"
method="post" enctype="text/plain">

<!--Name field for your name-->
<div class="mb-4">
<label class="form-label" for="name">Name</label>
<input class="form-control" type="text"
id="name" name="name" required>
</div>

<!--email field checks for an email address-->
<div class="mb-4">
<label class="form-label" for="email">Email</label>
<input class="form-control" type="email"
id="email" name="email" required>
</div>

<!--phone feild for a Phone number-->
<div class="mb-4">
<label class="form-label" for="phone">phone Number</label>
<input class="form-control" type="tel"
id="phone" name="phone">
</div>

<!--message field allows multiple lines of text-->
<div class="mb-4">
<label class="form-label" for="comments">Message</label>
<textarea class="form-control" id="comments"
name="comments" rows="6" required></textarea>
</div>

<!--it will open email after browser validation-->
<button class="btn button-lime" type="submit">
<i class="fa-solid fa-envelope" aria-hidden="true"></i>
Open Email App
</button>

</form>

</main>

<!--Includes the shared footer-->
<%- include('partials/footer') %>